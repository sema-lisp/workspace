# The workspace repo tracks ONLY its own tooling. Every member repo (cloned by
# scripts/ws.sh) and any scratch dir is ignored — ignore all, then allowlist.
/*
!/.gitignore
!/Jakefile
!/repos.tsv
!/repos.lock
!/.env.example
!/README.md
!/CLAUDE.md
!/scripts/

# sema-coder — flagship app, un-ignored so the workspace can see it
!/sema-coder

# Never commit real secrets
.env
