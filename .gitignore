# The workspace repo tracks ONLY its own tooling. Every member repo (cloned by
# scripts/ws.sh) and any scratch dir is ignored — ignore all, then allowlist.
/*
!/.gitignore
!/Jakefile
!/repos.tsv
!/repos.lock
!/.env.example
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/.clocignore
!/scripts/
!/.cargo/
!/.cargo/config.toml

# Never commit real secrets
.env
